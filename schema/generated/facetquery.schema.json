{
  "title": "FacetQuery",
  "description": "A search query translated into the catalogue facets. hard facets filter; soft facets only rank matches higher. Every facet value is facet-qualified. An empty array or a null year_min constrains nothing.",
  "type": "object",
  "properties": {
    "hard": {
      "$ref": "#/$defs/Facets"
    },
    "soft": {
      "$ref": "#/$defs/Facets"
    },
    "free_text_terms": {
      "description": "Phrases from the query kept for lexical search. Never a filter.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unmapped_terms": {
      "description": "Every query term no facet value expresses. Declare it here rather than force a value.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "description": "Each reading of an ambiguous phrase, one sentence each.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "description": "What the user wants done.",
      "type": "string",
      "enum": [
        "suite_build",
        "lookup",
        "compare",
        "ecosystem_question",
        "out_of_scope"
      ]
    },
    "confidence": {
      "description": "low when the query could not be mapped with confidence.",
      "type": "string",
      "enum": [
        "high",
        "low"
      ]
    }
  },
  "required": [
    "hard",
    "soft",
    "free_text_terms",
    "unmapped_terms",
    "assumptions",
    "intent",
    "confidence"
  ],
  "additionalProperties": false,
