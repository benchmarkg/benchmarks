{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from tools/build/croissant.py. Do not edit.",
  "title": "croissant-benchmark",
  "$defs": {
    "BenchmarkDocument": {
      "additionalProperties": false,
      "description": "One benchmark's document: build/croissant-benchmark/{id}.jsonld.",
      "properties": {
        "@context": {
          "$ref": "#/$defs/Context"
        },
        "@type": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "sc:Dataset",
              "type": "string"
            },
            {
              "const": "cb:Benchmark",
              "type": "string"
            }
          ],
          "title": "@Type",
          "type": "array"
        },
        "conformsTo": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "http://mlcommons.org/croissant/1.1",
              "type": "string"
            },
            {
              "const": "https://host.invalid/ns/croissant-benchmark/v1",
              "type": "string"
            }
          ],
          "title": "Conformsto",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "alternateName": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternatename",
          "type": "array"
        },
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "keywords": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "subjectOf": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subjectof"
        },
        "benchmarkId": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Benchmarkid",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskNode"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricNode"
          },
          "title": "Metrics",
          "type": "array"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolNode"
        },
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionsNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lineage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineageNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "@context",
        "@type",
        "conformsTo",
        "name",
        "url",
        "benchmarkId",
        "tasks",
        "protocol"
      ],
      "title": "BenchmarkDocument",
      "type": "object"
    },
    "CollectionDocument": {
      "additionalProperties": false,
      "description": "The catalogue's document: build/croissant-benchmark/_collection.jsonld.",
      "properties": {
        "@context": {
          "$ref": "#/$defs/Context"
        },
        "@type": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "sc:Dataset",
              "type": "string"
            },
            {
              "const": "cb:BenchmarkCollection",
              "type": "string"
            }
          ],
          "title": "@Type",
          "type": "array"
        },
        "conformsTo": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "http://mlcommons.org/croissant/1.1",
              "type": "string"
            },
            {
              "const": "https://host.invalid/ns/croissant-benchmark/v1",
              "type": "string"
            }
          ],
          "title": "Conformsto",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "license": {
          "const": "https://spdx.org/licenses/CC-BY-4.0.html",
          "title": "License",
          "type": "string"
        },
        "citeAs": {
          "minLength": 1,
          "title": "Citeas",
          "type": "string"
        },
        "hasPart": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "title": "Haspart",
          "type": "array"
        }
      },
      "required": [
        "@context",
        "@type",
        "conformsTo",
        "name",
        "description",
        "url",
        "license",
        "citeAs"
      ],
      "title": "CollectionDocument",
      "type": "object"
    },
    "ConditionsNode": {
      "additionalProperties": false,
      "description": "cb:EvalConditions: the reference to our EvalConditions entity and the comparability profile (08 S5.8).",
      "properties": {
        "@type": {
          "const": "cb:EvalConditions",
          "title": "@Type",
          "type": "string"
        },
        "conditionsId": {
          "anyOf": [
            {
              "pattern": "^cond-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditionsid"
        },
        "comparabilityProfile": {
          "anyOf": [
            {
              "enum": [
                "llm-static-text",
                "agentic",
                "model-graded",
                "hosted-api",
                "simulation",
                "physical-trial",
                "wet-lab",
                "forecasting",
                "surrogate-fit",
                "human-judged",
                "eligibility-gated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparabilityprofile"
        }
      },
      "required": [
        "@type"
      ],
      "title": "ConditionsNode",
      "type": "object"
    },
    "Context": {
      "additionalProperties": true,
      "properties": {
        "@vocab": {
          "const": "https://schema.org/",
          "title": "@Vocab",
          "type": "string"
        },
        "sc": {
          "const": "https://schema.org/",
          "title": "Sc",
          "type": "string"
        },
        "cb": {
          "const": "https://host.invalid/ns/croissant-benchmark/v1#",
          "title": "Cb",
          "type": "string"
        },
        "benchmarkId": {
          "const": "cb:benchmarkId",
          "title": "Benchmarkid",
          "type": "string"
        },
        "tasks": {
          "const": "cb:tasks",
          "title": "Tasks",
          "type": "string"
        },
        "metrics": {
          "const": "cb:metrics",
          "title": "Metrics",
          "type": "string"
        },
        "protocol": {
          "const": "cb:protocol",
          "title": "Protocol",
          "type": "string"
        },
        "conditions": {
          "const": "cb:conditions",
          "title": "Conditions",
          "type": "string"
        },
        "lineage": {
          "const": "cb:lineage",
          "title": "Lineage",
          "type": "string"
        },
        "input": {
          "const": "cb:input",
          "title": "Input",
          "type": "string"
        },
        "output": {
          "const": "cb:output",
          "title": "Output",
          "type": "string"
        },
        "scoring": {
          "const": "cb:scoring",
          "title": "Scoring",
          "type": "string"
        },
        "testsHiddenFromSystem": {
          "const": "cb:testsHiddenFromSystem",
          "title": "Testshiddenfromsystem",
          "type": "string"
        },
        "evaluationTarget": {
          "const": "cb:evaluationTarget",
          "title": "Evaluationtarget",
          "type": "string"
        },
        "executionMode": {
          "const": "cb:executionMode",
          "title": "Executionmode",
          "type": "string"
        },
        "groundTruthSource": {
          "const": "cb:groundTruthSource",
          "title": "Groundtruthsource",
          "type": "string"
        },
        "isHeadline": {
          "const": "cb:isHeadline",
          "title": "Isheadline",
          "type": "string"
        },
        "valueType": {
          "const": "cb:valueType",
          "title": "Valuetype",
          "type": "string"
        },
        "optimum": {
          "const": "cb:optimum",
          "title": "Optimum",
          "type": "string"
        },
        "optimumTarget": {
          "const": "cb:optimumTarget",
          "title": "Optimumtarget",
          "type": "string"
        },
        "unbounded": {
          "const": "cb:unbounded",
          "title": "Unbounded",
          "type": "string"
        },
        "submissionProcess": {
          "const": "cb:submissionProcess",
          "title": "Submissionprocess",
          "type": "string"
        },
        "dataAccess": {
          "const": "cb:dataAccess",
          "title": "Dataaccess",
          "type": "string"
        },
        "aggregationPolicy": {
          "const": "cb:aggregationPolicy",
          "title": "Aggregationpolicy",
          "type": "string"
        },
        "conditionsId": {
          "const": "cb:conditionsId",
          "title": "Conditionsid",
          "type": "string"
        },
        "comparabilityProfile": {
          "const": "cb:comparabilityProfile",
          "title": "Comparabilityprofile",
          "type": "string"
        },
        "lineageRole": {
          "const": "cb:lineageRole",
          "title": "Lineagerole",
          "type": "string"
        },
        "supersedes": {
          "const": "cb:supersedes",
          "title": "Supersedes",
          "type": "string"
        },
        "isSupersededBy": {
          "const": "cb:isSupersededBy",
          "title": "Issupersededby",
          "type": "string"
        },
        "subsetOf": {
          "const": "cb:subsetOf",
          "title": "Subsetof",
          "type": "string"
        },
        "extendedBy": {
          "const": "cb:extendedBy",
          "title": "Extendedby",
          "type": "string"
        },
        "decontaminates": {
          "const": "cb:decontaminates",
          "title": "Decontaminates",
          "type": "string"
        },
        "variants": {
          "const": "cb:variants",
          "title": "Variants",
          "type": "string"
        },
        "forks": {
          "const": "cb:forks",
          "title": "Forks",
          "type": "string"
        }
      },
      "required": [
        "@vocab",
        "sc",
        "cb",
        "benchmarkId",
        "tasks",
        "metrics",
        "protocol",
        "conditions",
        "lineage",
        "input",
        "output",
        "scoring",
        "testsHiddenFromSystem",
        "evaluationTarget",
        "executionMode",
        "groundTruthSource",
        "isHeadline",
        "valueType",
        "optimum",
        "optimumTarget",
        "unbounded",
        "submissionProcess",
        "dataAccess",
        "aggregationPolicy",
        "conditionsId",
        "comparabilityProfile",
        "lineageRole",
        "supersedes",
        "isSupersededBy",
        "subsetOf",
        "extendedBy",
        "decontaminates",
        "variants",
        "forks"
      ],
      "title": "Context",
      "type": "object"
    },
    "LineageNode": {
      "additionalProperties": false,
      "description": "cb:Lineage: supersession, subset, extension, decontamination, variant and fork edges (08 S5.8 `lineage`).",
      "properties": {
        "@type": {
          "const": "cb:Lineage",
          "title": "@Type",
          "type": "string"
        },
        "lineageRole": {
          "anyOf": [
            {
              "enum": [
                "root",
                "variant",
                "fork"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lineagerole"
        },
        "supersedes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "isSupersededBy": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": "Issupersededby",
          "type": "array"
        },
        "subsetOf": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subsetof"
        },
        "extendedBy": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": "Extendedby",
          "type": "array"
        },
        "decontaminates": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decontaminates"
        },
        "variants": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        },
        "forks": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": "Forks",
          "type": "array"
        }
      },
      "required": [
        "@type"
      ],
      "title": "LineageNode",
      "type": "object"
    },
    "MetricNode": {
      "additionalProperties": false,
      "description": "cb:Metric: a metric with its range and direction (08 S5.8 `metrics`). A named scoring note has a name only.",
      "properties": {
        "@type": {
          "const": "cb:Metric",
          "title": "@Type",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "isHeadline": {
          "title": "Isheadline",
          "type": "boolean"
        },
        "valueType": {
          "anyOf": [
            {
              "enum": [
                "ratio",
                "count",
                "duration",
                "currency",
                "elo",
                "ordinal",
                "categorical",
                "vector",
                "qualitative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valuetype"
        },
        "optimum": {
          "anyOf": [
            {
              "enum": [
                "max",
                "min",
                "zero",
                "target"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimum"
        },
        "optimumTarget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimumtarget"
        },
        "minValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minvalue"
        },
        "maxValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxvalue"
        },
        "unbounded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unbounded"
        }
      },
      "required": [
        "@type",
        "name",
        "isHeadline"
      ],
      "title": "MetricNode",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "description": "One entry of the collection's hasPart: a benchmark document, by its file name beside the collection. Typed\ncb:Benchmark alone: mlcroissant takes whichever schema.org Dataset node rdflib lists first for the document's\nown, so a document holds exactly one.",
      "properties": {
        "@id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}\\.jsonld$",
          "title": "@Id",
          "type": "string"
        },
        "@type": {
          "const": "cb:Benchmark",
          "title": "@Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "benchmarkId": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Benchmarkid",
          "type": "string"
        }
      },
      "required": [
        "@id",
        "@type",
        "name",
        "benchmarkId"
      ],
      "title": "Part",
      "type": "object"
    },
    "ProtocolNode": {
      "additionalProperties": false,
      "description": "cb:Protocol: how a result is produced and admitted (08 S5.8 `protocol`).",
      "properties": {
        "@type": {
          "const": "cb:Protocol",
          "title": "@Type",
          "type": "string"
        },
        "submissionProcess": {
          "items": {
            "enum": [
              "self-reported",
              "maintainer-verified",
              "sandboxed-rerun",
              "held-out-server",
              "containerized-algorithm-submission",
              "assessment-committee",
              "third-party-audited",
              "live-arena",
              "physical-competition",
              "publication-gated",
              "maintainer-run",
              "literature-only",
              "open-source-gated",
              "maintainer-scored-predictions"
            ],
            "type": "string"
          },
          "title": "Submissionprocess",
          "type": "array"
        },
        "dataAccess": {
          "enum": [
            "fully-open",
            "train-open-test-held-out",
            "gated-registration",
            "credentialed-dua",
            "private-test-server",
            "invitation-only",
            "restricted-dual-use",
            "proprietary-closed",
            "generated-on-demand"
          ],
          "title": "Dataaccess",
          "type": "string"
        },
        "aggregationPolicy": {
          "enum": [
            "official-aggregate",
            "community-aggregate",
            "none-by-design",
            "unknown"
          ],
          "title": "Aggregationpolicy",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "dataAccess",
        "aggregationPolicy"
      ],
      "title": "ProtocolNode",
      "type": "object"
    },
    "TaskNode": {
      "additionalProperties": false,
      "description": "cb:Task: what is asked (08 S5.8 `tasks`; 15 A8's task-and-protocol row).",
      "properties": {
        "@type": {
          "const": "cb:Task",
          "title": "@Type",
          "type": "string"
        },
        "input": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Input",
          "type": "array"
        },
        "output": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "scoring": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring"
        },
        "testsHiddenFromSystem": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testshiddenfromsystem"
        },
        "evaluationTarget": {
          "enum": [
            "learned-system",
            "numerical-method",
            "human-population",
            "mixed"
          ],
          "title": "Evaluationtarget",
          "type": "string"
        },
        "executionMode": {
          "anyOf": [
            {
              "enum": [
                "automated",
                "human-in-loop",
                "wet-lab",
                "physical-trial",
                "panel"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executionmode"
        },
        "groundTruthSource": {
          "anyOf": [
            {
              "enum": [
                "repository-tests",
                "held-out-labels",
                "simulation",
                "experimental",
                "expert-panel",
                "forecast-resolution",
                "formal-verifier",
                "released-classifier",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groundtruthsource"
        }
      },
      "required": [
        "@type",
        "evaluationTarget"
      ],
      "title": "TaskNode",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/BenchmarkDocument"
    },
    {
      "$ref": "#/$defs/CollectionDocument"
    }
  ]
}
