  "@type": [
    "sc:Dataset",
    "cb:Benchmark"
  ],
  "alternateName": [
    "WMT General MT shared task",
    "WMT News Translation Task",
    "WMT25 General MT Shared Task",
    "WMT26 General MT"
  ],
  "benchmarkId": "wmt-general-mt",
  "benchmarkVersions": [
    "2023",
    "2024",
    "2025",
    "2026"
  ],
  "conditions": {
    "@type": "cb:EvalConditions",
    "materialFields": [
      "chainOfThought",
      "eligibilityTrack",
      "gradingRubricRef",
      "harness",
      "humanAssistance",
      "humanInLoop",
      "judgeModel",
      "judgeModelVersion",
      "judgePromptHash",
      "nSamples",
      "reasoningEffort",
      "retriesAllowed",
      "sandbox",
      "scaffold",
      "selectionStrategy",
      "shots",
      "subsetUsed",
      "toolsAllowed",
      "trainingDataPolicy"
    ],
    "ratingPoolRequired": false
  },
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "https://host.invalid/ns/croissant-benchmark/v1"
  ],
  "description": "The main shared task of WMT, the Conference on Machine Translation (a workshop from 2006 to 2015, then a conference under ACL's SIGMT), formerly the News translation task. Each year the organisers build new test sets of recent, source-original documents, have professional agencies translate them, and release the sources as a blind set; teams translate them within about two weeks and upload the outputs to OCELoT, where no score is shown. The organisers also collect translations from popular LLMs and anonymised online services. The official ranking comes from human evaluation: Error Span Annotation (ESA) since 2024, with MQM for some pairs, by professional translators and, for some pairs, a paid crowd; systems are ranked by score into significance clusters per language pair. WMT25 had 30 language pairs, half human-evaluated, over news, social, speech, literary, education and dialogue documents. An automatic ranking (AutoRank: LLM judges and learned metrics, chrF++ for the lowest-resource pairs) chose which systems reached human evaluation and ranked the rest. WMT26 (23 pairs, instructions attached to each sample) evaluates every primary system by contrastive ESA and publishes no automatic ranking. Systems compete in a constrained track (open weights under 20B parameters) and an unconstrained one, and sources, outputs, references and judgements are released after each round.\n",
  "keywords": [
    "machine-translation",
    "shared-task",
    "human-evaluation",
    "document-level",
    "low-resource-languages"
  ],
  "license": "Research use (the task's own terms; no named licence)",
  "name": "WMT General Machine Translation",
  "protocol": {
    "@type": "cb:Protocol",
    "aggregationPolicy": "none-by-design",
    "dataAccess": "fully-open",
    "submissionProcess": [
      "held-out-server",
      "maintainer-run",
      "publication-gated"
    ],
    "subsets": [
      "wmt-general-mt#multilingual"
    ]
  },
  "tasks": [
    {
      "@type": "cb:Task",
      "evaluationTarget": "learned-system",
      "executionMode": "panel",
      "groundTruthSource": "expert-panel",
      "input": [
        "a source document in one of the edition's source languages (Czech, English, Japanese; Chinese too in 2026), from a domain such as news, social posts, speech, literary or education, with the domain's prompt instruction, and the video or screenshot for speech and social documents"
      ],
      "output": "The document's translation into the target language, keeping its paragraph (segment) breaks, as a JSON-lines hypothesis.",
      "scoring": "Per language pair, the micro-averaged human ESA (or MQM) segment score, with rank ranges from Wilcoxon signed-rank tests (p < 0.05) and clusters; constrained systems are also ranked among themselves. Through WMT25, AutoRank (GEMBA-ESA judges, MetricX, XCOMET, CometKiwi; chrF++ for Bhojpuri and Maasai) chose about 18 systems per pair for human evaluation and ranked the rest."
    }
  ],
  "url": "https://www2.statmt.org/wmt26/translation-task.html"
}
