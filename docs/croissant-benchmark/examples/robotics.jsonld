  "@type": [
    "sc:Dataset",
    "cb:Benchmark"
  ],
  "benchmarkId": "roboarena",
  "conditions": {
    "@type": "cb:EvalConditions",
    "materialFields": [
      "hardwarePlatform",
      "nSamples",
      "simulator",
      "simulatorVersion",
      "subsetUsed",
      "venue"
    ],
    "ratingPoolRequired": true
  },
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "https://host.invalid/ns/croissant-benchmark/v1"
  ],
  "description": "Submitters host a manipulation policy as a remote policy server. Volunteer evaluators at institutions with a DROID robot are handed two anonymised policies, choose any task and scene they like, run both under the same conditions, and record which they preferred, a 0-100 progress score for each, and a free-text explanation. A Bradley-Terry-style model with ties aggregates the preferences into a relative rating. There is no task list, no fixed test set and no absolute score.\n",
  "keywords": [
    "evaluator-improvised"
  ],
  "license": "MIT",
  "metrics": [
    {
      "@type": "cb:Metric",
      "identifier": "roboarena-rating",
      "isHeadline": true,
      "name": "RoboArena score",
      "optimum": "max",
      "unbounded": true,
      "valueType": "elo"
    },
    {
      "@type": "cb:Metric",
      "identifier": "roboarena-pairwise-win-rate",
      "isHeadline": false,
      "maxValue": 100.0,
      "minValue": 0.0,
      "name": "RoboArena win rate against one opponent",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    }
  ],
  "name": "RoboArena",
  "protocol": {
    "@type": "cb:Protocol",
    "aggregationPolicy": "official-aggregate",
    "dataAccess": "generated-on-demand",
    "submissionProcess": [
      "live-arena"
    ]
  },
  "tasks": [
    {
      "@type": "cb:Task",
      "evaluationTarget": "learned-system"
    }
  ],
  "url": "https://robo-arena.github.io/"
}
