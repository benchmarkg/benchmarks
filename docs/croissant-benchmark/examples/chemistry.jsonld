  "@type": [
    "sc:Dataset",
    "cb:Benchmark"
  ],
  "alternateName": [
    "A framework to evaluate machine learning crystal stability predictions",
    "Matbench Discovery -- A framework to evaluate machine learning crystal stability predictions"
  ],
  "benchmarkId": "matbench-discovery",
  "conditions": {
    "@type": "cb:EvalConditions",
    "materialFields": [
      "decontaminationApplied",
      "eligibilityTrack",
      "subsetUsed",
      "trainingDataEligibility",
      "trainingDataPolicy"
    ],
    "ratingPoolRequired": false
  },
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "https://host.invalid/ns/croissant-benchmark/v1"
  ],
  "description": "A leaderboard and Python package that evaluate machine-learning energy models, mostly universal interatomic potentials, as pre-filters in a high-throughput search for stable inorganic crystals. The core task scores stability predictions on the WBM test set against a fixed DFT convex hull built from the Materials Project; further tasks score geometry optimisation, phonons and lattice thermal conductivity, and diatomic energy curves. Models are grouped by the training data they were allowed to use. The leaderboard sorts by a weighted composite whose weights the viewer can change. Known weaknesses the sources name: regression metrics such as MAE can look good while false positives near the stability threshold stay high, and the reference is PBE DFT, not experiment.\n",
  "keywords": [
    "compliance-tiers",
    "dft-reference"
  ],
  "license": "MIT",
  "lineage": {
    "@type": "cb:Lineage",
    "lineageRole": "root"
  },
  "metrics": [
    {
      "@type": "cb:Metric",
      "identifier": "matbench-cps",
      "isHeadline": true,
      "name": "CPS",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "f1-score",
      "isHeadline": false,
      "maxValue": 1.0,
      "minValue": 0.0,
      "name": "F1",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "discovery-acceleration-factor",
      "isHeadline": false,
      "minValue": 0.0,
      "name": "DAF",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "e-above-hull-mae",
      "isHeadline": false,
      "minValue": 0.0,
      "name": "MAE (hull distance)",
      "optimum": "min",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "structure-rmsd",
      "isHeadline": false,
      "minValue": 0.0,
      "name": "RMSD",
      "optimum": "min",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "kappa-srme",
      "isHeadline": false,
      "maxValue": 2.0,
      "minValue": 0.0,
      "name": "κSRME",
      "optimum": "min",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "phonon-spectrum-w1",
      "isHeadline": false,
      "minValue": 0.0,
      "name": "W1(ω)",
      "optimum": "min",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "matbench-cmds",
      "isHeadline": false,
      "maxValue": 1.0,
      "minValue": 0.0,
      "name": "CMDS",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    },
    {
      "@type": "cb:Metric",
      "identifier": "matbench-cds",
      "isHeadline": false,
      "maxValue": 1.0,
      "minValue": 0.0,
      "name": "CDS",
      "optimum": "max",
      "unbounded": false,
      "valueType": "ratio"
    }
  ],
  "name": "Matbench Discovery",
  "protocol": {
    "@type": "cb:Protocol",
    "aggregationPolicy": "official-aggregate",
    "dataAccess": "fully-open",
    "submissionProcess": [
      "maintainer-verified"
    ],
    "subsets": [
      "matbench-discovery#discovery",
      "matbench-discovery#unique-prototypes",
      "matbench-discovery#full-test-set",
      "matbench-discovery#10k-most-stable",
      "matbench-discovery#geo-opt",
      "matbench-discovery#phonons",
      "matbench-discovery#diatomics",
      "matbench-discovery#md"
    ]
  },
  "tasks": [
    {
      "@type": "cb:Task",
      "evaluationTarget": "learned-system",
      "executionMode": "automated",
      "groundTruthSource": "simulation",
      "input": [
        "unrelaxed WBM crystal structure (discovery, geometry optimisation)",
        "PhononDB structure (phonons and thermal conductivity)"
      ],
      "output": "Per task: a formation energy per atom for each WBM structure (discovery); the relaxed structure (geometry optimisation); lattice thermal conductivity (phonons).",
      "scoring": "Discovery: predicted stability is on or below a fixed DFT convex hull built from the Materials Project v2022.10.28 release, scored by F1, DAF, precision and recall, with MAE, RMSE and R2 on the hull distance. Geometry optimisation: RMSD to the DFT-relaxed structure. Phonons: κSRME.",
      "testsHiddenFromSystem": false
    }
  ],
  "url": "https://matbench-discovery.materialsproject.org/"
}
