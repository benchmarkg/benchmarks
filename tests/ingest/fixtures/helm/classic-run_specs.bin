[
 {
  "name": "exampleqa:dataset=example,model=example-org_model-a",
  "scenario_spec": {
   "class_name": "helm.benchmark.scenarios.example_scenario.ExampleQA",
   "args": {
    "dataset": "example"
   }
  },
  "adapter_spec": {
   "method": "generation",
   "global_prefix": "",
   "instructions": "Answer the invented question about the invented passage.\n",
   "input_prefix": "Q: ",
   "input_suffix": "\n",
   "reference_prefix": "A. ",
   "reference_suffix": "\n",
   "output_prefix": "A: ",
   "output_suffix": "\n",
   "instance_prefix": "\n",
   "substitutions": [],
   "max_train_instances": 0,
   "max_eval_instances": 1000,
   "num_outputs": 1,
   "num_train_trials": 1,
   "sample_train": true,
   "model": "example-org/model-a",
   "temperature": 0.0,
   "max_tokens": 100,
   "stop_sequences": [
    "\n"
   ],
   "multi_label": false
  },
  "metric_specs": [
   {
    "class_name": "helm.benchmark.metrics.basic_metrics.BasicMetric",
    "args": {
     "names": [
      "exact_match"
     ]
    }
   }
  ],
  "data_augmenter_spec": {
   "perturbation_specs": [],
   "seeds_per_instance": 1
  },
  "groups": [
   "exampleqa"
  ]
 }
]