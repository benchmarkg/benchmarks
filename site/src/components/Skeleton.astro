---
// site/src/components/Skeleton.astro -- P2-S2-T06 (09 S6.11). A placeholder for content that genuinely arrives late,
// sized to the final element's exact box so nothing shifts when it lands. It animates only when the reader allows
// motion (prefers-reduced-motion: no-preference); otherwise it is a static tinted block.
//
// NEVER: sit on a statically rendered page. Only the three late arrivals 09 S6.11 names may have one -- the
// Workbench's corpus fetch, the semantic-search tier and the AI panel -- and anything else throws: a skeleton on
// an entry, list or taxonomy page is a lie about the architecture.
interface Props {
  for: 'workbench-corpus' | 'semantic-search' | 'ai-panel';
  inline_size: string;
  block_size: string;
}

const LATE =['workbench-corpus', 'semantic-search', 'ai-panel'];
const { for: what, inline_size, block_size } = Astro.props;
if (!LATE.includes(what)) {
  throw new Error(`Skeleton for ${JSON.stringify(what)}: only ${LATE.join(', ')} arrive late (09 S6.11); a static page has no skeleton`);
}
---
<div class="skeleton" data-skeleton={what} style={`inline-size: ${inline_size}; block-size: ${block_size}`} aria-hidden="true"></div>

<style>
  .skeleton {
    background: var(--c-surface-sunken);
  }
  @media (prefers-reduced-motion: no-preference) {
    .skeleton {
      background: linear-gradient(90deg, var(--c-surface-sunken) 25%, var(--c-surface) 50%, var(--c-surface-sunken) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.4s linear infinite;
    }
  }
  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }
</style>
