---
// site/src/components/Contribute.astro -- P2-S2-T06 (09 S6.14). On every entry page. The primary action is "Suggest a
// correction", a pre-filled GitHub issue form; a smaller "Edit the YAML" link serves power users.
//
// NEVER: make the pull-request path the prominent one. The landscape's clearest failure (a JSON-in-git catalogue that
// closed itself over PR friction) is reproduced in the interface whenever the most visible affordance is a PR, so
// the issue form comes first and looks like the action; the edit link comes second and smaller.
import { CORRECTION_FORM, editOnMain, fill } from '../lib/repo';

interface Props {
  entity_id: string;
  entity_kind: string;
  yaml_path: string;
  issue_form?: string;
}

const { entity_id, entity_kind, yaml_path, issue_form = CORRECTION_FORM } = Astro.props;
const form = fill(issue_form, { entity_id, entity_kind });
if (!form.includes('/issues/new')) throw new Error(`Contribute ${entity_id}: the primary action must be an issue form, not ${form}`);
---
<aside class="contribute" data-contribute={entity_id}>
  <a class="primary" data-action="correction" href={form}>Suggest a correction</a>
  <a class="secondary" data-action="edit-yaml" href={editOnMain(yaml_path)}>Edit the YAML</a>
</aside>

<style>
  .contribute {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
  }
  .primary {
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--c-link);
    background: var(--c-select-bg);
    color: var(--c-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .secondary {
    font-size: var(--fs-xs);
    color: var(--c-ink-muted);
  }
</style>
