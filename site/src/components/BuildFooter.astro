---
// site/src/components/BuildFooter.astro -- P2-S3-T07 (10 "The permanent citation URL"; 08 S4.4). The footer every page
// carries: the release tag, the commit SHA and the build timestamp, and the one sentence saying an artifact URL is a
// cache key, not a citation. A page that cannot tell you which version of the data produced it is not a citable page.
// Base.astro renders it; a page with its own shell (feed/index.astro) renders it too. tools/build/citation.py checks
// that every built page has it, and that one build shows one commit and one timestamp.
import { release } from '../lib/release';
import { REPO } from '../lib/repo';

const build = release();
---
<footer class="site-footer" data-build-footer>
  <p>Release {build.tag != null ? <code data-release>{build.tag}</code> : <span data-release>no tagged release yet</span>} · commit <a href={`${REPO}/commit/${build.commit_sha}`}><code data-commit={build.commit_sha}>{build.commit_sha.slice(0, 12)}</code></a> · built <time data-built datetime={build.built_at}>{build.built_at}</time></p>
  <p data-cache-key-sentence>An artifact URL is a cache key, not a citation: cite the YAML at a commit, or the release and its DOI.</p>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--sp-12);
    padding: var(--sp-4);
    border-block-start: 1px solid var(--c-border);
    color: var(--c-ink-muted);
    font-size: var(--fs-xs);
  }
  .site-footer p {
    margin: 0 0 var(--sp-1);
  }
</style>
