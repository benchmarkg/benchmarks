---
// site/src/components/Absent.astro -- P2-S2-T06 (09 S6.9, S11.2). The absence token: ∅ in --c-absent-ink plus
// one of the four fixed phrases. A missing value is a fact with a name, so it occupies space.
//
// NEVER: an empty string, a blank cell, a dash or a zero. An unknown state throws: there is no fifth phrase.
import { absencePhrase } from '../lib/vocab';

interface Props {
  state: string;
  reason?: string;
}

const { state, reason } = Astro.props;
const phrase = absencePhrase(state);
---
<span class="absent" data-absent={state}><span class="glyph" aria-hidden="true">∅</span> {phrase}{reason != null && <span class="reason"> ({reason})</span>}</span>

<style>
  .absent {
    color: var(--c-absent-ink);
    font-size: var(--fs-xs);
  }
  .glyph {
    font-weight: 600;
  }
</style>
