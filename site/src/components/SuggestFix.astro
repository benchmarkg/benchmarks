---
// site/src/components/SuggestFix.astro -- P2-S6-T05 (05 S6; 09 S6.14). The field-level "Suggest a correction": a small
// link beside one editable field, opening the correction issue form with the entity id and the field's YAML path
// already in its two plain text inputs (lib/repo.ts correctionHref). Its visible word is short; its accessible name
// says which field, so a screen-reader list of links is not forty "correct"s.
//
// NEVER: point at the pull-request path, or prefill through a dropdown id (dropdown prefill is unverified).
import { correctionHref } from '../lib/repo';

interface Props {
  entity: string;
  field: string;       // the YAML path, e.g. data.access
  label: string;       // what the page calls it, e.g. Data access
}

const { entity, field, label } = Astro.props;
---
<a class="fix" data-action="correction" data-field={field} href={correctionHref(entity, field)}>correct<span class="visually-hidden"> {label}</span></a>

<style>
  .fix {
    margin-inline-start: var(--sp-2);
    font-size: var(--fs-2xs);
    font-weight: 400;
    color: var(--c-ink-muted);
  }
  .fix:hover {
    color: var(--c-link);
  }
</style>
