---
// site/src/components/ThemeToggle.astro -- P2-S2-T07 (09 S9). The three-state theme toggle: system, light,
// dark, defaulting to system. Three radio buttons in a fieldset, so each state is named in words and reachable
// by keyboard, and the current one is announced. It is `hidden` until its script runs: without JavaScript a
// control that cannot work is not shown, and the page follows the OS preference (09 S12.3).
import { CHOICES } from '../lib/theme';

const LABELS = { system: 'System', light: 'Light', dark: 'Dark' } as const;
---
<fieldset class="theme-toggle" data-theme-toggle hidden>
  <legend>Theme</legend>
  {CHOICES.map((c) => (
    <label><input type="radio" name="theme" value={c} checked={c === 'system'} /> {LABELS[c]}</label>
  ))}
</fieldset>

<script>
  import { readChoice, setChoice, type ThemeChoice } from '../lib/theme';

  for (const box of document.querySelectorAll<HTMLFieldSetElement>('[data-theme-toggle]')) {
    const chosen = readChoice();
    for (const input of box.querySelectorAll<HTMLInputElement>('input[name="theme"]')) {
      input.checked = input.value === chosen;
      input.addEventListener('change', () => {
        if (input.checked) setChoice(input.value as ThemeChoice);
      });
    }
    box.hidden = false;
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--c-border-strong);
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle legend {
    float: left;
    padding: 0;
    margin-inline-end: 0.25rem;
    color: var(--c-ink-muted);
  }
  .theme-toggle input:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
</style>
