---
// site/src/components/FacetChips.astro -- P2-S2-T06 (09 S6.2). A row of FacetChip: at most six before a "+N more"
// disclosure. One element per line is safe here because compressHTML is literally true (astro.config.mjs).
import FacetChip from './FacetChip.astro';

interface Chip {
  facet: string;
  term_id: string;
  state?: 'static' | 'filter-available' | 'filter-active';
  count?: number;
  href?: string;
}
interface Props {
  chips: Chip[];
}

const VISIBLE = 6;
const { chips } = Astro.props;
const shown = chips.slice(0, VISIBLE);
const more = chips.slice(VISIBLE);
---
<span class="chips" data-chips>
  {shown.map((c) => <FacetChip {...c} />)}
  {more.length > 0 && (
    <details class="more">
      <summary>+{more.length} more</summary>
      {more.map((c) => <FacetChip {...c} />)}
    </details>
  )}
</span>

<style>
  .chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    align-items: center;
  }
  .more {
    display: inline;
    font-size: var(--fs-xs);
  }
</style>
