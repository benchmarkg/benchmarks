---
// site/src/components/DisputeRaiser.astro -- P3-S10-T09 (05 S8). Who raised a dispute, or reported the correction
// that names it, as /corrections/ may say it (lib/corrections.ts reporterOf): an organisation the corpus publishes,
// linked to its page and followed by its relationship to what it disputes, or the neutral role that relationship
// gives ("a third party", "the evaluated party", "a reader"). The relationship is always there, in words or as the
// role itself, because "an organisation contesting its own score is useful information, and so is the fact that it
// is the one contesting".
//
// NEVER: a person's name, handle or e-mail address. The record's raw `raised_by` is never printed; a value that is
// not a published organisation id renders as the role, and `redacted` says the identity was withheld on request.
import { RELATIONSHIP_LABEL, type Reporter } from '../lib/corrections';

interface Props {
  reporter: Reporter;
}

const { reporter: r } = Astro.props;
---
<span class="raiser" data-raiser={r.kind} data-relationship={r.relationship}>{r.kind === 'organisation'
  ? <><a href={`/orgs/${r.id}/`} data-raiser-org={r.id}>{r.name}</a> ({RELATIONSHIP_LABEL[r.relationship]})</>
  : <><span data-raiser-role>{r.role}</span>{r.withheld === true ? <span data-raiser-withheld>, identity withheld at their request</span> : null}</>}</span>
