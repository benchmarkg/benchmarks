---
// site/src/pages/benchmarks/index.astro -- P2-S4-T04 (10 V11, "Information architecture": /benchmarks/ is "V11 faceted
// browse"; 09 S10; 12 S5.3). The browse view: a facet rail beside a result list, the counts live
// (islands/FacetPanel.tsx; lib/browse-view.ts holds the rules).
//
// What the page gives the island, all of it fixed at build time:
//   facetsHref   facets.json's content-hashed URL, from lib/manifest.ts dataHref(), the only way a page names a /data/
//                file (08 S4.4; S13 fails a build whose HTML references any other). Null when the build wrote no
//                manifest, and the view then says it cannot combine terms rather than fetching a file it does not have
//   groups       the rail's vocabularies, from taxonomy/ itself (lib/terms.ts), each term with its definition for the
//                hover and its /taxonomy/ and /browse/ segments
//   families     each domain family's reviewer sign-off (lib/vocab.ts signoff()), which the curation-confidence
//                indicator at the top of the rail reads for whatever domain is filtered
//   published    how many benchmarks the build published, which the page states before facets.json arrives
//
// The island is server-rendered, so the page as sent is the rail with every term linking its single-facet page
// (/browse/{facet}/{term}/): with JavaScript off it is a route into the catalogue, and combining terms is what
// JavaScript adds (10 V11, "Without JavaScript"). Below --bp-md (P2-S4-T05, 09 S10) the rail is a sheet opened from a
// "Filters (N)" button in a sticky bar above the results, with the applied filters as that bar's second line, one row
// that scrolls sideways; the sheet is a popover, so it opens with JavaScript off too (islands/FilterSheet.tsx).
//
// In the search index (P2-S4-T06) the view is a narrative page, crawled for its heading and lede; the panel is
// data-pagefind-ignore, because every term and benchmark it lists has its own record, and indexing them here would
// answer every term search twice (08 S7.5 Decision 2's reason for leaving /browse/ out).
import Base from '../../layouts/Base.astro';
import FacetPanel from '../../islands/FacetPanel.tsx';
import { benchmarks } from '../../lib/collections';
import { railGroups, type Family } from '../../lib/browse-view';
import { dataHref } from '../../lib/manifest';
import { allTerms } from '../../lib/terms';
import { signoff } from '../../lib/vocab';

const groups = railGroups(allTerms());
const families: Family[] = groups.find((g) => g.key === 'd')!.terms.filter((t) => t.parent == null)
  .map((t) => ({ id: t.id, label: t.label, signoff: signoff(t.id) }));
const published = (await benchmarks()).length;
const facetsHref = dataHref('facets.json');
---
<Base title="Browse benchmarks · Benchmark index">
  <main class="browse">
    <header>
      <h1>Browse benchmarks</h1>
      <p class="lede">Combine terms from any facet to narrow the list. Within a facet, terms widen it; across facets, they narrow it. A term with no benchmark stays in the panel, disabled, because where nothing is measured is part of the answer.</p>
    </header>
    <div data-pagefind-ignore="all">
      <FacetPanel client:load facetsHref={facetsHref} groups={groups} families={families} published={published} />
    </div>
  </main>
</Base>

<style>
  .browse {
    max-inline-size: 90rem;
    margin-inline: auto;
    padding: var(--sp-4);
  }
  h1 { margin: 0 0 var(--sp-2); font-size: var(--fs-2xl); line-height: var(--lh-tight); }
  .lede { max-inline-size: 68ch; margin: 0 0 var(--sp-6); color: var(--c-ink-muted); }

  /* the island renders without this page's scope, so its markup is styled from here */
  .browse :global(.facet-panel) { display: grid; gap: var(--sp-6); }
  /* 09 S5.3: the rail beside the list from --bp-md (51rem; a custom property cannot sit in a media query) */
  @media (min-width: 51rem) {
    .browse :global(.facet-panel) { grid-template-columns: 20rem minmax(0, 1fr); align-items: start; }
  }
  /* 09 S8.2: a second skip link, past the filter rail; off screen until focused, and out of the grid either way */
  .browse :global(.facet-panel) { position: relative; }
  .browse :global(.skip) { position: absolute; z-index: 3; inset-block-start: 0; inset-inline-start: -100vw; padding: var(--sp-1) var(--sp-2); background: var(--c-bg); }
  .browse :global(.skip:focus) { inset-inline-start: 0; }
  .browse :global(h2) { margin: 0 0 var(--sp-3); font-size: var(--fs-lg); }
  .browse :global(.n), .browse :global(.count) { color: var(--c-ink-muted); font-weight: 400; font-variant-numeric: tabular-nums slashed-zero; }
  .browse :global(.n) { font-size: var(--fs-xs); }

  .browse :global(.confidence) { margin: 0 0 var(--sp-3); padding: var(--sp-2) var(--sp-3); border: 1px solid var(--c-caution); background: var(--c-caution-bg); font-size: var(--fs-sm); }
  .browse :global(.confidence[data-curation-confidence='reviewed']) { border-color: var(--c-border); background: var(--c-bg); }

  /* the rail's groups, by element: a chip's facet name is a span.group too, and as a flex item it took this border and
     padding, which made every chip taller than 09 S6.2's 24px (28 at coarse pointers) and drew a rule across it */
  .browse :global(details.group) { border-block-start: 1px solid var(--c-border); padding-block: var(--sp-2); }
  .browse :global(details.group > summary) { cursor: pointer; font-weight: 600; min-block-size: 1.5rem; }
  .browse :global(.terms) { list-style: none; margin: var(--sp-1) 0 0; padding: 0; }
  .browse :global(.terms .terms) { padding-inline-start: var(--sp-6); }
  .browse :global(.subdomains > summary) { cursor: pointer; padding-inline-start: var(--sp-6); font-size: var(--fs-xs); color: var(--c-ink-muted); }
  .browse :global(.row) { position: relative; display: flex; align-items: center; gap: var(--sp-2); min-block-size: 1.5rem; font-size: var(--fs-sm); }
  .browse :global(.row label) { cursor: pointer; }
  .browse :global(.row input:disabled + label) { cursor: default; color: var(--c-ink-faint); }

  /* The definition on hover and on keyboard focus (10 V11). It opens beside the rail, over the list, so it never covers
     another term; it stays while the pointer is on it, and Escape hides it until the pointer or focus moves (SC 1.4.13).
     Hover waits a moment, so a pointer passing down the rail does not flash every definition; a mouse click leaves no
     definition open, because only :focus-visible opens one from focus. The rail does not scroll on its own, which would
     clip it. Touch has no hover, so in the phone sheet (P2-S4-T05) a definition shows on keyboard focus only: a touch
     control for it is not built yet, and without JavaScript each term's single-facet page links its definition. */
  .browse :global(.gloss) {
    visibility: hidden;
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline-start: 100%;
    inline-size: 22rem;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
  }
  .browse :global(.gloss p) { margin: 0 0 var(--sp-1); }
  @media (hover: hover) {
    .browse :global(.row:hover > .gloss) { visibility: visible; transition: visibility 0s linear 0.3s; }
  }
  /* Tab from a term's checkbox goes on to its own "Full definition" link. The browser takes focus, and :focus-visible,
     off the checkbox before it hands focus to the link and checks that the link can take it; with the definition shown
     by :has(:focus-visible) alone it was hidden in that moment, and focus fell to the page (P2-S8-T04,
     tests/keyboard.spec.ts). :focus-within holds the row across the step, the row containing both; a checkbox a click
     has focused is still left out, so a click opens no definition. :where() keeps the rule below the Escape one. */
  .browse :global(.row:has(:focus-visible) > .gloss),
  .browse :global(.row:where(:focus-within:not(:has(input:focus:not(:focus-visible)))) > .gloss) { visibility: visible; }
  .browse :global(.rail[data-hush] .gloss) { visibility: hidden; }
  /* stacked below --bp-md: under the row, inside the page */
  @media (max-width: 50.99rem) {
    .browse :global(.gloss) { inset-block-start: 100%; inset-inline: 0; inline-size: auto; }
  }

  .browse :global(.applied) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); margin-block-end: var(--sp-3); }
  .browse :global(.chips) { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: 0; padding: 0; }
  /* 09 S6.2: an applied filter is a filled ground AND a × affordance; 24px tall, 28px at coarse pointers; a 3px radius */
  .browse :global(.chip), .browse :global(.clear), .browse :global(.drop) {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-block-size: 1.5rem;
    padding-inline: var(--sp-2);
    border: 1px solid var(--c-border-strong);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
    cursor: pointer;
  }
  .browse :global(.chip[data-state='filter-active']) { background: var(--c-select-bg); border-color: var(--c-link); }
  .browse :global(.chip .group) { color: var(--c-ink-muted); }
  .browse :global(.chip .remove) { font-weight: 700; }
  @media (pointer: coarse) {
    .browse :global(.chip), .browse :global(.clear), .browse :global(.drop), .browse :global(.row) { min-block-size: 1.75rem; }
  }
  .browse :global(.none) { margin: 0; color: var(--c-ink-muted); font-size: var(--fs-sm); }
  .browse :global(.notice) { margin: 0 0 var(--sp-3); padding: var(--sp-2) var(--sp-3); border: 1px solid var(--c-caution); background: var(--c-caution-bg); font-size: var(--fs-sm); }
  .browse :global(.notice p), .browse :global(.notice ul) { margin: 0; }

  .browse :global(.results) { display: grid; gap: var(--sp-2); margin: 0; padding-inline-start: var(--sp-6); }
  .browse :global(.results .meta) { font-size: var(--fs-xs); color: var(--c-ink-muted); font-variant-numeric: tabular-nums slashed-zero; }
  .browse :global(.empty) { max-inline-size: 68ch; }

  /* 09 S10, the phone layout (P2-S4-T05; islands/FilterSheet.tsx). Below --bp-md the rail is a popover sheet, closed
     until the "Filters (N)" button opens it, and the bar above the results -- the heading, that button and the
     applied-filter chips -- sticks to the top of the screen, so the filters in force are in sight wherever the reader is
     in the list. Each line of the bar is one line whatever it holds, so applying a filter never changes its height and
     never moves the list. All of it only where the browser has the Popover API; elsewhere the rail stacks above the
     list, as it did. From --bp-md up the popover is laid out in place as the rail, with the UA's popover box undone,
     and neither the button nor the sheet's footer is shown. */
  .browse :global(.open-sheet), .browse :global(.sheet-foot) { display: none; }
  @media (min-width: 51rem) {
    .browse :global(.filter-sheet:not(:popover-open)) {
      display: block;
      position: static;
      inset: auto;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      border: 0;
      padding: 0;
      overflow: visible;
      background: none;
      color: inherit;
    }
  }
  @media (max-width: 50.99rem) {
    @supports selector(:popover-open) {
      .browse :global(.skip) { display: none; }
      .browse :global(.results-head) {
        position: sticky;
        z-index: 1;
        inset-block-start: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--sp-2) var(--sp-3);
        margin: 0 calc(-1 * var(--sp-4)) var(--sp-3);
        padding: var(--sp-2) var(--sp-4);
        border-block-end: 1px solid var(--c-border);
        background: var(--c-bg);
      }
      .browse :global(.results-head > h2) { margin: 0; font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .browse :global(.open-sheet) { display: inline-flex; }
      /* the chips: one line that scrolls sideways and never wraps, as tall with no chip as with ten */
      .browse :global(.results-head > .applied) {
        grid-column: 1 / -1;
        flex-wrap: nowrap;
        min-block-size: 1.75rem;
        margin: 0;
        overflow-x: auto;
        overflow-y: hidden;
        overscroll-behavior-inline: contain;
        scrollbar-width: thin;
      }
      .browse :global(.results-head .chips) { flex-wrap: nowrap; }
      .browse :global(.results-head .applied > *), .browse :global(.results-head .chips > li) { flex: none; white-space: nowrap; }
      /* SC 2.4.11 (09 S8.1: the sticky filter bar "must not cover a focused row"). What takes focus in the list under the
         bar -- a result, the empty result's button -- is scrolled into view below it, not under it: its scroll margin is
         the bar's height (one line of the 2.25rem button, one of the 1.75rem chip row, the gap between them, the bar's
         padding and its rule) and room for the focus ring. Without it, Shift+Tab up the list stopped on results the bar
         covered (P2-S8-T04, tests/keyboard.spec.ts). */
      .browse :global(.results-body :is(a, button)) { scroll-margin-block-start: calc(2.25rem + 1.75rem + 3 * var(--sp-2) + 1px + var(--sp-2)); }
      /* the list is the page and never moves under the reader: the browser does not re-anchor the page on a row that a
         filter has moved within the list, and FilterSheet.tsx usePinnedList() holds the list when what is above it
         changes */
      .browse :global(.facet-panel) { overflow-anchor: none; }
    }
  }
  .browse :global(.open-sheet), .browse :global(.sheet-done) {
    align-items: center;
    justify-content: center;
    min-block-size: 2.25rem;
    padding-inline: var(--sp-3);
    border: 1px solid var(--c-border-strong);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
  }
  /* The open sheet: the popover covers the screen and is its own scroll container, its box above the panel a scrim of
     the page's ground. The panel is a pixel taller than what is left, so the sheet always scrolls and overscroll-behavior
     holds: a drag on the panel or the scrim never reaches the page under it. The footer stays at the foot of the screen. */
  .browse :global(.filter-sheet:popover-open) {
    position: fixed;
    inset: 0;
    inline-size: auto;
    block-size: auto;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    border: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: color-mix(in oklch, var(--c-bg) 70%, transparent);
    color: var(--c-ink);
  }
  .browse :global(.filter-sheet:popover-open > .sheet-panel) {
    display: flex;
    flex-direction: column;
    min-block-size: calc(85dvh + 1px);
    margin-block-start: 15dvh;
    padding: var(--sp-4) var(--sp-4) 0;
    border-block-start: 1px solid var(--c-border-strong);
    background: var(--c-bg);
  }
  .browse :global(.filter-sheet:popover-open .sheet-foot) {
    display: block;
    position: sticky;
    inset-block-end: 0;
    margin: auto calc(-1 * var(--sp-4)) 0;
    padding: var(--sp-3) var(--sp-4);
    border-block-start: 1px solid var(--c-border);
    background: var(--c-bg);
  }
  /* SC 2.4.11: Tab down the rail scrolls each term into view above the sticky footer, not under it -- the footer's height
     (the 2.75rem button, its padding and its rule) and room for the focus ring (P2-S8-T04, tests/keyboard.spec.ts) */
  .browse :global(.filter-sheet:popover-open .rail :is(a, input, summary)) { scroll-margin-block-end: calc(2.75rem + 2 * var(--sp-3) + 1px + var(--sp-2)); }
  .browse :global(.sheet-done) { display: flex; inline-size: 100%; min-block-size: 2.75rem; border-color: var(--c-link); background: var(--c-select-bg); }
</style>
