---
// site/src/pages/systems/[id].astro -- P2-S3-T04. /systems/{id}/: one page per published system (views/SystemDetail).
// cacheKey is the content digest of the system and every record the page renders from it (08 S4.3; as the
// benchmark route does), its claims.json rows among them (P3-S10-T07).
import Base from '../../layouts/Base.astro';
import SystemDetail from '../../views/SystemDetail.astro';
import { onlyRoutes } from '../../lib/bench-routes';
import { baseId, claimsDoc, sortClaims, type ClaimRow } from '../../lib/claims';
import { benchmarks, metrics, organizations, sources, systems } from '../../lib/collections';
import { contentDigest } from '../../lib/corpus';
import type { Organization } from '../../types/organization';
import type { Source } from '../../types/source';
import type { System } from '../../types/system';

export async function getStaticPaths() {
  const all = await systems();
  const orgs = new Map((await organizations()).map((o) => [o.id, o]));
  const srcs = new Map((await sources()).map((s) => [s.id, s]));
  const ids = new Set(all.map((s) => s.id));
  const doc = claimsDoc();
  const metricById = new Map((await metrics()).map((m) => [m.id, m]));
  const names = { systems: new Map(all.map((s) => [s.id, s.name])), benchmarks: new Map((await benchmarks()).map((b) => [b.id, b.name])) };
  const about = (id: string) => (doc == null ? null
    : sortClaims(doc.rows.filter((r) => baseId(r.claim.system) === id || (r.claim.opponent != null && baseId(r.claim.opponent) === id)), metricById));
  return onlyRoutes(all.map((s) => {
    const claims = about(s.id);
    const listed = (claims ?? []).map((r) => [r.claim.system, r.claim.opponent, r.claim.benchmark]
      .map((x) => (x != null ? names.systems.get(baseId(x)) ?? names.benchmarks.get(baseId(x)) ?? null : null)));
    return {
      params: { id: s.id },
      props: { system: s, organizations: orgs, systems: ids, sources: srcs, claims, names },
      cacheKey: contentDigest({ system: s, organization: s.organization != null ? orgs.get(s.organization) ?? null : null,
        sources: (s.sources ?? []).map((id) => srcs.get(id) ?? null), built_on: (s.built_on ?? []).map((r) => ids.has(r.split('@', 1)[0])),
        claims, listed, optimum: (claims ?? []).map((r) => metricById.get(r.claim.metric)?.optimum ?? null) }),
    };
  }), (p) => `/systems/${p.params.id}/`);
}

interface Props {
  system: System;
  organizations: Map<string, Organization>;
  systems: Set<string>;
  sources: Map<string, Source>;
  claims: ClaimRow[] | null;
  names: { systems: Map<string, string>; benchmarks: Map<string, string> };
}

const p = Astro.props;
---
<Base title={`${p.system.name} · Benchmark index`} zeroJs search="record">
  <main>
    <SystemDetail system={p.system} organizations={p.organizations} systems={p.systems} sources={p.sources} claims={p.claims} names={p.names} />
  </main>
</Base>
