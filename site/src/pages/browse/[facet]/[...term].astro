---
// site/src/pages/browse/[facet]/[...term].astro -- P2-S4-T01. /browse/{facet}/{term}/: the single-facet browse pages,
// one per value a single filter can take (lib/browse.ts says which, and why the facet in the URL is the field a
// filter constrains), each a complete index of its members with no JavaScript (views/BrowsePage). It uses a rest
// parameter because a domain value carries its family: /browse/domain/code/repository-scale-se/. The route set is
// single-facet only, and no intersection family such as /browse/domain/{d}/capability/{c}/ is generated (08 S8.3).
// test/browse-routes.test.mjs holds the set to the taxonomy and the corpus. cacheKey is the content digest of what
// the page renders.
import Base from '../../../layouts/Base.astro';
import BrowsePage from '../../../views/BrowsePage.astro';
import { onlyRoutes } from '../../../lib/bench-routes';
import { benchmarks, organizations } from '../../../lib/collections';
import { browsePages, browseParams, type BrowsePage as Page, type Neighbour } from '../../../lib/browse';
import { contentDigest } from '../../../lib/corpus';
import { signoff } from '../../../lib/vocab';

export async function getStaticPaths() {
  const pages = browsePages(await benchmarks(), await organizations());
  const ns = (list: Neighbour[]) => list.map((x) => [x.term.id, x.term.label, x.count]);
  return onlyRoutes(pages.map((page) => ({
    params: browseParams(page),
    props: { page },
    cacheKey: contentDigest({
      page: page.kind === 'term'
        ? { term: page.term, parent: page.parent?.label ?? null, families: ns(page.families), children: ns(page.children), siblings: ns(page.siblings) }
        : { org: [page.org.id, page.org.name] },
      members: page.members == null ? null : page.members.map((m) => [m.benchmark.id, m.benchmark.name, m.benchmark.domain.primary,
        m.benchmark.released ?? null, m.secondary]),
      review: page.kind === 'term' && page.term.facet === 'domain' ? signoff(page.term.parent ?? page.term.id) : null,
    }),
  })), (p) => `/browse/${p.params.facet}/${p.params.term}/`);
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const label = page.kind === 'term' ? page.term.label : page.org.name;
const by = page.kind === 'term' ? page.segment.replace(/-/g, ' ') : 'maintainer';
---
<Base title={`${label} · browse by ${by} · Benchmark index`} zeroJs>
  <main>
    <BrowsePage page={page} />
  </main>
</Base>
