---
// site/src/pages/docs/[...slug].astro -- P2-S3-T05. /docs/{slug}/: docs/methodology.md, docs/provenance.md and
// docs/comparability.md (the `docs` collection), rendered with Astro's markdown pipeline. Zero JavaScript.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = String(entry.data.title);
---
<Base title={`${title} · Benchmark index`} zeroJs>
  <main>
    <article class="prose" data-doc={entry.id}>
      <Content />
    </article>
  </main>
</Base>

<style>
  .prose {
    max-inline-size: 68ch;
    margin-inline: auto;
    padding: var(--sp-4);
    line-height: var(--lh-prose);
  }
  .prose :global(h1) { font-size: var(--fs-2xl); line-height: var(--lh-tight); }
  .prose :global(h2) { margin-block-start: var(--sp-8); font-size: var(--fs-lg); }
  .prose :global(table) { border-collapse: collapse; font-size: var(--fs-sm); display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { padding: var(--sp-1) var(--sp-2); border-block-end: 1px solid var(--c-border); text-align: start; vertical-align: top; }
  .prose :global(pre) { overflow-x: auto; padding: var(--sp-3); background: var(--c-surface-sunken); font-size: var(--fs-sm); }
  .prose :global(blockquote) { margin-inline: 0; padding-inline-start: var(--sp-4); border-inline-start: 3px solid var(--c-border-strong); }
</style>
