---
// site/src/pages/atlas.astro -- P2-S5-T02 (10 V1, "Information architecture": /atlas/ is V1; 08 S4.3, S5.2; 09 S4.2,
// S4.3). The Atlas: every benchmark a node on one map, placed by the build's pack layout (atlas.json), drawn by sigma in
// islands/Atlas.tsx, mounted client:visible so the map's libraries load when the map is on screen and not before.
//
// What the page gives the island, all of it fixed at build time:
//   atlasHref, facetsHref   atlas.json's and facets.json's content-hashed URLs (lib/manifest.ts dataHref, 08 S4.4): the
//                           map's nodes, and the rows the filter matches. Null when the build wrote no manifest, or no
//                           atlas.json (`bench build --atlas` writes it; scripts/preview_corpus.py writes the preview's)
//   groups                  the browse rail's vocabularies (lib/browse-view.ts railGroups), so the map reads and writes
//                           the same filter grammar as /benchmarks/; the definitions are left out, which the map never shows
//   taglines                each published benchmark's tagline, for the hover card (10 V1 "Interactions"). atlas.json
//                           carries no tagline (10 V1 "Data consumed", tools/atlas/emit.py), so it comes from the
//                           collection here: one sentence of at most 120 characters per benchmark
//   palettes                the colours the map paints with in each theme, tokens.json's hex through lib/atlas.ts
//                           palette(): sigma's WebGL takes a colour value, not a CSS custom property, and the page passes
//                           the eighteen it needs rather than the island importing the whole token file
//
// In the search index (P2-S4-T06; Base.astro `search`) the Atlas is a narrative page, crawled for its heading and lede.
// The island is data-pagefind-ignore: every benchmark it names has its own record, and the crawl would otherwise answer a
// benchmark's name twice, the reason 08 S7.5 gives for leaving /browse/ out.
//
// Without JavaScript the frame says where the same benchmarks are (the browse view). The grouped family index that is
// the map's legend, its no-JS form and its keyboard path (10 V1 "Without JavaScript", 09 S8.2) is P2-S5-T03's.
import Base from '../layouts/Base.astro';
import Atlas from '../islands/Atlas.tsx';
import { benchmarks } from '../lib/collections';
import { railGroups } from '../lib/browse-view';
import { dataHref } from '../lib/manifest';
import { allTerms } from '../lib/terms';
import { palette } from '../lib/atlas';
import tokens from '../lib/tokens.json';

const groups = railGroups(allTerms()).map((g) => ({ ...g, terms: g.terms.map((t) => ({ ...t, gloss: '' })) }));
const taglines = Object.fromEntries((await benchmarks()).map((b) => [b.id, b.tagline]));
const atlasHref = dataHref('atlas.json');
const facetsHref = dataHref('facets.json');
const palettes = { light: palette('light', tokens as never), dark: palette('dark', tokens as never) };
---
<Base title="Atlas · Benchmark index">
  <main class="atlas">
    <header>
      <h1>Atlas</h1>
      <p class="lede">Every benchmark in the index on one map. Benchmarks sit inside their subdomain, their domain family and its presentation group, and a node is larger the more systems report results on it. Filtering dims what does not match and never moves a node, so a place on the map stays the same place.</p>
    </header>
    <div data-pagefind-ignore="all">
      <Atlas client:visible atlasHref={atlasHref} facetsHref={facetsHref} groups={groups} taglines={taglines} palettes={palettes} />
    </div>
  </main>
</Base>

<style>
  .atlas {
    max-inline-size: 120rem;
    margin-inline: auto;
    padding: var(--sp-4);
  }
  h1 { margin: 0 0 var(--sp-2); font-size: var(--fs-2xl); line-height: var(--lh-tight); }
  .lede { max-inline-size: 68ch; margin: 0 0 var(--sp-4); color: var(--c-ink-muted); }

  /* the island renders without this page's scope, so its markup is styled from here */
  .atlas :global(.filters) { display: grid; gap: var(--sp-2); margin-block-end: var(--sp-3); }
  .atlas :global(.controls) { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .atlas :global(.control) { display: grid; gap: var(--sp-05); font-size: var(--fs-sm); }
  .atlas :global(.control .label) { color: var(--c-ink-muted); font-size: var(--fs-xs); }
  .atlas :global(.control select) { max-inline-size: 18rem; min-block-size: 1.75rem; font: inherit; color: var(--c-ink); background: var(--c-bg); border: 1px solid var(--c-border-strong); border-radius: 3px; }
  .atlas :global(.applied) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); }
  .atlas :global(.count) { margin: 0; font-size: var(--fs-sm); color: var(--c-ink-muted); font-variant-numeric: tabular-nums slashed-zero; }
  .atlas :global(.chips) { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: 0; padding: 0; }
  /* 09 S6.2: an applied filter is a filled ground AND a × affordance; 24px tall, 28px at coarse pointers */
  .atlas :global(.chip), .atlas :global(.clear), .atlas :global(.close) {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-block-size: 1.5rem;
    padding-inline: var(--sp-2);
    border: 1px solid var(--c-border-strong);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
    cursor: pointer;
  }
  .atlas :global(.chip) { background: var(--c-select-bg); border-color: var(--c-link); }
  .atlas :global(.chip .group) { color: var(--c-ink-muted); }
  .atlas :global(.chip .remove) { font-weight: 700; }
  @media (pointer: coarse) {
    .atlas :global(.chip), .atlas :global(.clear), .atlas :global(.close) { min-block-size: 1.75rem; }
  }
  .atlas :global(.notice) { margin: 0; padding: var(--sp-2) var(--sp-3); border: 1px solid var(--c-caution); background: var(--c-caution-bg); font-size: var(--fs-sm); }
  .atlas :global(.notice p), .atlas :global(.notice ul) { margin: 0; }

  /* The map and its summary column. The column is reserved whether or not a benchmark is chosen, so opening the
     summary never resizes the map and the camera keeps its place (10 V1 "Click"). From --bp-md (51rem) it sits beside
     the map; below, under it. */
  .atlas :global(.body) { display: grid; gap: var(--sp-4); }
  @media (min-width: 51rem) {
    .atlas :global(.body) { grid-template-columns: minmax(0, 1fr) 20rem; align-items: start; }
  }
  .atlas :global(.frame) {
    position: relative;
    block-size: min(75vh, 46rem);
    min-block-size: 22rem;
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    overflow: hidden;
  }
  .atlas :global(.canvas) { position: absolute; inset: 0; }
  .atlas :global(.canvas.pointing) { cursor: pointer; }
  .atlas :global(.fallback) { position: absolute; inset: var(--sp-4) var(--sp-4) auto; margin: 0; max-inline-size: 60ch; color: var(--c-ink-muted); }

  /* the hover card: beside the node, never under the pointer, and not a thing a pointer can land on */
  .atlas :global(.card) {
    position: absolute;
    z-index: 2;
    inline-size: 20rem;
    max-inline-size: calc(100% - var(--sp-4));
    transform: translateY(-50%);
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
    pointer-events: none;
  }
  .atlas :global(.card .name) { margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .atlas :global(.card .tagline), .atlas :global(.summary .tagline) { margin: var(--sp-1) 0; }
  .atlas :global(.card dl), .atlas :global(.summary dl) { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-05) var(--sp-2); margin: 0; }
  .atlas :global(.card dt), .atlas :global(.summary dt) { color: var(--c-ink-muted); }
  .atlas :global(.card dd), .atlas :global(.summary dd) { margin: 0; }

  .atlas :global(.panel) { min-block-size: 6rem; font-size: var(--fs-sm); }
  .atlas :global(.panel h2) { margin: 0; font-size: var(--fs-lg); line-height: var(--lh-tight); }
  .atlas :global(.panel .hint) { margin: 0; color: var(--c-ink-muted); }
  .atlas :global(.panel .actions) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3); margin: var(--sp-3) 0 0; }

  .atlas :global(.absent) { color: var(--c-absent-ink); }
  .atlas :global(.absent .glyph) { font-weight: 600; }
</style>
