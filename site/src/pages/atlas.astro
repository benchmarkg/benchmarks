---
// site/src/pages/atlas.astro -- P2-S5-T02 (10 V1, "Information architecture": /atlas/ is V1; 08 S4.3, S5.2; 09 S4.2,
// S4.3). The Atlas: every benchmark a node on one map, placed by the build's pack layout (atlas.json), drawn by sigma in
// islands/Atlas.tsx, mounted client:visible so the map's libraries load when the map is on screen and not before.
//
// What the page gives the island, all of it fixed at build time:
//   atlasHref, facetsHref   atlas.json's and facets.json's content-hashed URLs (lib/manifest.ts dataHref, 08 S4.4): the
//                           map's nodes, and the rows the filter matches. Null when the build wrote no manifest, or no
//                           atlas.json (`bench build --atlas` writes it; scripts/preview_corpus.py writes the preview's)
//   groups                  the browse rail's vocabularies (lib/browse-view.ts railGroups), so the map reads and writes
//                           the same filter grammar as /benchmarks/; the definitions are left out, which the map never shows
//   taglines                each published benchmark's tagline, for the hover card (10 V1 "Interactions"). atlas.json
//                           carries no tagline (10 V1 "Data consumed", tools/atlas/emit.py), so it comes from the
//                           collection here: one sentence of at most 120 characters per benchmark
//   palettes                the colours the map paints with in each theme, tokens.json's hex through lib/atlas.ts
//                           palette(): sigma's WebGL takes a colour value, not a CSS custom property, and the page passes
//                           the eighteen it needs rather than the island importing the whole token file
//
// In the search index (P2-S4-T06; Base.astro `search`) the Atlas is a narrative page, crawled for its heading and lede.
// The island is data-pagefind-ignore: every benchmark it names has its own record, and the crawl would otherwise answer a
// benchmark's name twice, the reason 08 S7.5 gives for leaving /browse/ out.
//
// The island's children are the family index (P2-S5-T03, components/AtlasIndex.astro): the grouped list of the build's
// atlas.json that is the map's legend, its no-JS form, its screen-reader linearisation and its keyboard path (10 V1
// "Without JavaScript", "And it is also the legend"; 09 S8.2). It is rendered inside the canvas container, beside the
// stage the map is drawn on; the island hydrates it as static HTML and, once the map is drawn, takes it over in place
// (its toggles live, a roving tabindex over it), so the page never holds two. Without JavaScript the list is the page,
// and the stage says where else the benchmarks are (the browse view).
//
// The selection (P2-S5-T04, islands/AtlasSelection.tsx) is the island's own: its toolbar between the filter bar and the
// map, its lasso over the map, a check on a selected benchmark in the list. It needs nothing from the page but the
// styles below.
import Base from '../layouts/Base.astro';
import Atlas from '../islands/Atlas.tsx';
import AtlasIndex from '../components/AtlasIndex.astro';
import { benchmarks } from '../lib/collections';
import { railGroups } from '../lib/browse-view';
import { dataHref } from '../lib/manifest';
import { allTerms } from '../lib/terms';
import { palette } from '../lib/atlas';
import tokens from '../lib/tokens.json';

const groups = railGroups(allTerms()).map((g) => ({ ...g, terms: g.terms.map((t) => ({ ...t, gloss: '' })) }));
const taglines = Object.fromEntries((await benchmarks()).map((b) => [b.id, b.tagline]));
const atlasHref = dataHref('atlas.json');
const facetsHref = dataHref('facets.json');
const palettes = { light: palette('light', tokens as never), dark: palette('dark', tokens as never) };
---
<Base title="Atlas · Benchmark index">
  <main class="atlas">
    <header>
      <h1>Atlas</h1>
      <p class="lede">Every benchmark in the index on one map. Benchmarks sit inside their subdomain, their domain family and its presentation group, and a node is larger the more systems report results on it. Filtering dims what does not match and never moves a node, so a place on the map stays the same place.</p>
    </header>
    <div data-pagefind-ignore="all">
      <Atlas client:visible atlasHref={atlasHref} facetsHref={facetsHref} groups={groups} taglines={taglines} palettes={palettes}>
        <AtlasIndex />
      </Atlas>
    </div>
  </main>
</Base>

<style>
  .atlas {
    max-inline-size: 120rem;
    margin-inline: auto;
    padding: var(--sp-4);
  }
  h1 { margin: 0 0 var(--sp-2); font-size: var(--fs-2xl); line-height: var(--lh-tight); }
  .lede { max-inline-size: 68ch; margin: 0 0 var(--sp-4); color: var(--c-ink-muted); }

  /* the island renders without this page's scope, so its markup is styled from here */
  .atlas :global(.filters) { display: grid; gap: var(--sp-2); margin-block-end: var(--sp-3); }
  .atlas :global(.controls) { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .atlas :global(.control) { display: grid; gap: var(--sp-05); font-size: var(--fs-sm); }
  .atlas :global(.control .label) { color: var(--c-ink-muted); font-size: var(--fs-xs); }
  .atlas :global(.control select) { max-inline-size: 18rem; min-block-size: 1.75rem; font: inherit; color: var(--c-ink); background: var(--c-bg); border: 1px solid var(--c-border-strong); border-radius: 3px; }
  .atlas :global(.applied) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); }
  .atlas :global(.count) { margin: 0; font-size: var(--fs-sm); color: var(--c-ink-muted); font-variant-numeric: tabular-nums slashed-zero; }
  .atlas :global(.chips) { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: 0; padding: 0; }
  /* 09 S6.2: an applied filter is a filled ground AND a × affordance; 24px tall, 28px at coarse pointers. The selection's
     buttons (islands/AtlasSelection.tsx) and the summary's are the same 24px targets (09 S8.1, SC 2.5.8). */
  .atlas :global(.chip), .atlas :global(.clear), .atlas :global(.actions button), .atlas :global(.selection button) {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-block-size: 1.5rem;
    padding-inline: var(--sp-2);
    border: 1px solid var(--c-border-strong);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
    cursor: pointer;
  }
  .atlas :global(.chip) { background: var(--c-select-bg); border-color: var(--c-link); }
  .atlas :global(.chip .group) { color: var(--c-ink-muted); }
  .atlas :global(.chip .remove) { font-weight: 700; }
  @media (pointer: coarse) {
    .atlas :global(.chip), .atlas :global(.clear), .atlas :global(.actions button), .atlas :global(.selection button) { min-block-size: 1.75rem; }
  }
  /* The selection (P2-S5-T04, islands/AtlasSelection.tsx): one row between the filter bar and the map, its count in the
     filter count's face. The lasso's toggle, pressed, takes the outline a pressed legend toggle does. */
  .atlas :global(.selection) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); margin-block-end: var(--sp-3); }
  .atlas :global(.selection [aria-pressed="true"]) { box-shadow: inset 0 0 0 1px var(--c-ink); font-weight: 600; }
  /* its "Add to suite basket" (P6-S4-T01): a link, since it goes to another page, as tall a target as the buttons */
  .atlas :global(.selection a) { display: inline-flex; align-items: center; min-block-size: 1.5rem; font-size: var(--fs-xs); }
  @media (pointer: coarse) {
    .atlas :global(.selection a) { min-block-size: 1.75rem; }
  }
  .atlas :global(.notice) { margin: 0; padding: var(--sp-2) var(--sp-3); border: 1px solid var(--c-caution); background: var(--c-caution-bg); font-size: var(--fs-sm); }
  .atlas :global(.notice p), .atlas :global(.notice ul) { margin: 0; }

  /* The map and its summary column. The column is reserved whether or not a benchmark is chosen, so opening the
     summary never resizes the map and the camera keeps its place (10 V1 "Click"). From --bp-md (51rem) it sits beside
     the map; below, under it. */
  .atlas :global(.body) { display: grid; gap: var(--sp-4); }
  @media (min-width: 51rem) {
    .atlas :global(.body) { grid-template-columns: minmax(0, 1fr) 20rem; align-items: start; }
  }
  /* The canvas container: the family index (P2-S5-T03) and the stage the map is drawn on. The index comes first in
     reading order, so a keyboard or screen-reader reader meets the list before the picture of it. From --bp-lg (69rem)
     it is a column beside the stage, as tall as the stage and scrolling inside it; below, a shorter scrolling block
     above the stage. Its height is fixed in both, so nothing moves when the map is drawn beside it. */
  .atlas :global(.frame) {
    --atlas-h: min(75vh, 46rem);
    display: grid;
    border: 1px solid var(--c-border);
    background: var(--c-bg);
  }
  .atlas :global(.stage) {
    position: relative;
    block-size: var(--atlas-h);
    min-block-size: 22rem;
    overflow: hidden;
  }
  @media (min-width: 69rem) {
    .atlas :global(.frame:has(.atlas-index, .atlas-index-empty)) { grid-template-columns: 16rem minmax(0, 1fr); }
  }
  .atlas :global(.canvas) { position: absolute; inset: 0; }
  .atlas :global(.canvas.pointing) { cursor: pointer; }
  /* the lasso, while it is on: over the map, taking the pointer (and the touch, which would otherwise scroll) from it */
  .atlas :global(.lasso) { position: absolute; inset: 0; z-index: 1; inline-size: 100%; block-size: 100%; cursor: crosshair; touch-action: none; }
  .atlas :global(.fallback) { position: absolute; inset: var(--sp-4) var(--sp-4) auto; margin: 0; max-inline-size: 60ch; color: var(--c-ink-muted); }

  /* the hover card: beside the node, never under the pointer, and not a thing a pointer can land on */
  .atlas :global(.card) {
    position: absolute;
    z-index: 2;
    inline-size: 20rem;
    max-inline-size: calc(100% - var(--sp-4));
    transform: translateY(-50%);
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: var(--fs-xs);
    line-height: var(--lh-dense);
    pointer-events: none;
  }
  .atlas :global(.card .name) { margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .atlas :global(.card .tagline), .atlas :global(.summary .tagline) { margin: var(--sp-1) 0; }
  .atlas :global(.card dl), .atlas :global(.summary dl) { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-05) var(--sp-2); margin: 0; }
  .atlas :global(.card dt), .atlas :global(.summary dt) { color: var(--c-ink-muted); }
  .atlas :global(.card dd), .atlas :global(.summary dd) { margin: 0; }

  .atlas :global(.panel) { min-block-size: 6rem; font-size: var(--fs-sm); }
  .atlas :global(.panel h2) { margin: 0; font-size: var(--fs-lg); line-height: var(--lh-tight); }
  .atlas :global(.panel .hint) { margin: 0; color: var(--c-ink-muted); }
  .atlas :global(.panel .actions) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3); margin: var(--sp-3) 0 0; }
  /* its link is a 24px target too (SC 2.5.8): as a line of text it was 18px tall, and where the buttons wrap under it, at
     phone width, too close to them for the SC's spacing exception (P2-S8-T04, tests/keyboard.spec.ts) */
  .atlas :global(.panel .actions a) { display: inline-flex; align-items: center; min-block-size: 1.5rem; }

  /* The family index (components/AtlasIndex.astro, taken over by islands/Atlas.tsx). Family is carried by the label and
     the group band, never by a colour (09 S4.2 (b), (c)): no swatch, no hue, one ink. A group is a hairline rule and its
     name at --fs-sm in --c-ink-muted; a family row is its label in the condensed face at --c-ink, its count, and the
     highlight toggle, whose pressed state is the one emphasis token the map's outline takes (09 S4.2 (d)). */
  .atlas :global(.atlas-index), .atlas :global(.atlas-index-empty) {
    max-block-size: 20rem;
    overflow-y: auto;
    margin: 0;
    padding: var(--sp-3);
    border-block-end: 1px solid var(--c-border);
    font-size: var(--fs-sm);
    line-height: var(--lh-dense);
  }
  @media (min-width: 69rem) {
    .atlas :global(.atlas-index), .atlas :global(.atlas-index-empty) {
      max-block-size: none;
      block-size: var(--atlas-h);
      min-block-size: 22rem;
      border-block-end: 0;
      border-inline-end: 1px solid var(--c-border);
    }
  }
  .atlas :global(.index-title) { margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .atlas :global(.index-keys) { margin: var(--sp-1) 0 0; color: var(--c-ink-muted); font-size: var(--fs-xs); }
  .atlas :global(.index-groups), .atlas :global(.index-families), .atlas :global(.index-entries) { list-style: none; margin: 0; padding: 0; }
  .atlas :global(.index-group) { margin-block-start: var(--sp-3); padding-block-start: var(--sp-2); border-block-start: 1px solid var(--c-border); }
  .atlas :global(.group-label) { margin: 0 0 var(--sp-1); font-size: var(--fs-sm); font-weight: 400; color: var(--c-ink-muted); }
  .atlas :global(.index-family) { margin-block-end: var(--sp-2); }
  .atlas :global(.family-row) { display: flex; align-items: center; gap: var(--sp-2); }
  .atlas :global(.family-label) { flex: 1; margin: 0; font-family: var(--font-cond); font-size: var(--fs-sm); font-weight: 600; color: var(--c-ink); }
  .atlas :global(.family-count) { color: var(--c-ink-muted); font-size: var(--fs-xs); font-variant-numeric: tabular-nums slashed-zero; }
  /* 09 S8.1, SC 2.5.8: a legend toggle is at least 24 by 24 CSS px */
  .atlas :global(.highlight) {
    min-block-size: 1.5rem;
    min-inline-size: 1.5rem;
    padding-inline: var(--sp-2);
    border: 1px solid var(--c-border-strong);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .atlas :global(.highlight[aria-pressed="true"]) { border-color: var(--c-emphasis); box-shadow: inset 0 0 0 1px var(--c-emphasis); font-weight: 600; }
  .atlas :global(.highlight:disabled) { color: var(--c-ink-muted); border-color: var(--c-border); cursor: default; }
  .atlas :global(.index-entries) { margin-block-start: var(--sp-05); padding-inline-start: var(--sp-3); }
  .atlas :global(.index-entries a) { display: flex; align-items: center; min-block-size: 1.5rem; }
  /* a benchmark in the selection (P2-S5-T04): a check after its name, a glyph rather than a colour (09 S4.6, SC 1.4.1),
     whose alternative text is part of the link's accessible name */
  .atlas :global(.index-entries a[data-selected])::after { content: "\2713" / " selected"; margin-inline-start: var(--sp-1); font-weight: 700; }

  .atlas :global(.absent) { color: var(--c-absent-ink); }
  .atlas :global(.absent .glyph) { font-weight: 600; }
</style>
