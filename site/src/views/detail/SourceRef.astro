---
// site/src/views/detail/SourceRef.astro -- P2-S3-T01. A curated statement's evidence on the detail page: the
// verbatim quote, when there is one, then the source it came from as a link (09 S6.6's rule, shortened for inline
// use: the full citation with its archive link and retrieval date is in the page's Sources section, which this
// anchors to). A source id the corpus does not hold renders as the id, never as a guessed link.
import type { Source } from '../../types/source';

interface Props {
  id: string | null | undefined;
  quote?: string | null;
  sources: Map<string, Source>;
}

const { id, quote, sources } = Astro.props;
const s = id != null ? sources.get(id) : undefined;
---
{quote != null && quote !== '' && <q class="quote">{quote}</q>}
{id != null && (s != null
  ? <span class="ref">(<a href={`#${id}`} data-source-ref={id}>{s.title ?? id}</a>)</span>
  : <span class="ref">(<code>{id}</code>)</span>)}

<style>
  .quote {
    font-style: italic;
  }
  .ref {
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
  }
</style>
