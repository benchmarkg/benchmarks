---
// site/src/views/browse/MemberList.astro -- P2-S4-T01. A browse page's member list (views/BrowsePage), one line per
// benchmark: its name, linked, then its primary domain and release year. It has no <style> of its own on purpose. A
// component with scoped styles stamps its scope attribute on every element it renders, about 25 bytes each, and a
// list of 300 members would pay that five times a line. BrowsePage styles these lines from outside through :global.
import Absent from '../../components/Absent.astro';
import type { Member } from '../../lib/browse';
import { term } from '../../lib/vocab';

interface Props {
  members: Member[];
  which: 'primary' | 'secondary';
}

const { members, which } = Astro.props;
const domainLine = (d: string) => {
  const [family, sub] = d.split('/');
  return sub != null ? `${term('domain', family).label} · ${term('domain', d).label}` : term('domain', family).label;
};
---
<ul class="members" data-list={which}>{members.map(({ benchmark: b }) => (
  <li data-member={b.id}><a href={`/benchmarks/${b.id}/`}>{b.name}</a> <span class="meta">{domainLine(b.domain.primary)} · {b.released != null ? b.released.slice(0, 4) : <Absent state="not-recorded" reason="release date" />}</span></li>
))}</ul>
