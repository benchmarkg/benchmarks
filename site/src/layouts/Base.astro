---
// site/src/layouts/Base.astro -- P2-S2-T07. The page shell every page renders inside.
//
// Its first child of <head> after the two metas is theme.ts's PREPAINT, inline: the one render-blocking
// script the site allows (09 S9, S12.2). It writes the stored theme to <html data-theme> before <body>
// exists, so a reader who chose dark under a light OS (or the other way round) never sees a flash of the
// other theme. Everything else is a module or a stylesheet. The tokens (generated, tokens.css) and the type
// stack (type.css) are global here, so no page re-imports them.
//
// `zeroJs` (P2-S3-T01) is for the pages that exist to be cited, which ship zero JavaScript (08 S4.3): it leaves
// out the theme toggle, whose module script is the only other JavaScript the shell carries. PREPAINT stays -- 09 S9
// allows it on every page, and it is what applies a reader's stored theme on a page that has no toggle. Without
// the toggle the page follows that stored choice, or the OS preference, which is what ThemeToggle.astro already
// does when its script cannot run.
//
// Every page's footer prints the release tag, the commit SHA and the build timestamp, and says in one sentence that an
// artifact URL is a cache key, not a citation (10 "The permanent citation URL", 08 S4.4; P2-S3-T07): a page that
// cannot tell you which version of the data produced it is not a citable page.
//
// A draft-preview build (UAIBI_SITE_DRAFTS=1 over scripts/preview_corpus.py's corpus; lib/corpus.ts) says so on every
// page, so a screenshot of a preview can never pass for the published index.
//
// `search` (P2-S4-T06; 08 S3.2, S7.5 Decision 2) is how the one search index holds the page (lib/pagefind.ts, S12):
//   crawl    the default: a narrative page, which exists only as HTML and is indexed by Pagefind's crawl of dist/. It
//            carries the `type: page` filter, and the shell around its <main> -- banners, header, footer -- is ignored,
//            so its entry is the page's own words
//   record   an entity route (benchmark, system, organization, metric, taxonomy term), indexed by a custom record built
//            from its validated YAML (tools/build/pagefind_records.py), so its <body> carries data-pagefind-ignore and
//            the crawl skips it: one URL, indexed once
//   none     a route 08 S7.5 leaves out of the index (/browse/, version-pinned views): ignored the same way, no record
// scripts/check_pagefind_urls.py holds every built page to its family's mode.
import FontPreloads from '../components/FontPreloads.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { PREPAINT } from '../lib/theme';
import { bannerText, dormancy } from '../lib/dormancy';
import { corpusDoc } from '../lib/corpus';
import BuildFooter from '../components/BuildFooter.astro';
import '../styles/tokens.css';
import '../styles/type.css';

interface Props {
  title: string;
  zeroJs?: boolean;
  search?: 'crawl' | 'record' | 'none';
}

const { title, zeroJs = false, search = 'crawl' } = Astro.props;
const preview = corpusDoc().drafts;
// SUCCESSION.md item 5: at 180 days without a human commit to data/, every page says so (P0-S7-T04).
const stale = bannerText(dormancy());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-prepaint set:html={PREPAINT}></script>
    <title>{title}</title>
    <FontPreloads />
    {search === 'crawl' && <meta data-pagefind-filter="type[content]" content="page" />}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={search === 'crawl' ? undefined : 'all'}>
    {preview && <p class="staleness-banner" role="status" data-draft-preview data-pagefind-ignore>Draft preview: this build includes entries an agent drafted and no person has verified. It is never published.</p>}
    {stale && <p class="staleness-banner" role="status" data-staleness-banner data-pagefind-ignore>{stale}</p>}
    <header class="site-header" data-pagefind-ignore>
      <a class="site-name" href="/">Benchmark index</a>
      {!zeroJs && <ThemeToggle />}
    </header>
    <slot />
    <BuildFooter />
  </body>
</html>

<style is:global>
  html {
    background: var(--c-bg);
    color: var(--c-ink);
  }
  body {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-ink);
  }
  a {
    color: var(--c-link);
  }
  a:visited {
    color: var(--c-link-visited);
  }
  :focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
</style>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--c-border);
  }
  .staleness-banner {
    margin: 0;
    padding: 0.5rem 1rem;
    border-block-end: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-ink);
    font-weight: 600;
  }
  .site-name {
    color: var(--c-ink);
    font-weight: 600;
    text-decoration: none;
  }
</style>
