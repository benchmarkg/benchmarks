---
// site/src/layouts/Base.astro -- P2-S2-T07. The page shell every page renders inside.
//
// Its first child of <head> after the two metas is theme.ts's PREPAINT, inline: the one render-blocking
// script the site allows (09 S9, S12.2). It writes the stored theme to <html data-theme> before <body>
// exists, so a reader who chose dark under a light OS (or the other way round) never sees a flash of the
// other theme. Everything else is a module or a stylesheet. The tokens (generated, tokens.css) and the type
// stack (type.css) are global here, so no page re-imports them.
import FontPreloads from '../components/FontPreloads.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { PREPAINT } from '../lib/theme';
import '../styles/tokens.css';
import '../styles/type.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-prepaint set:html={PREPAINT}></script>
    <title>{title}</title>
    <FontPreloads />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Benchmark index</a>
      <ThemeToggle />
    </header>
    <slot />
  </body>
</html>

<style is:global>
  html {
    background: var(--c-bg);
    color: var(--c-ink);
  }
  body {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-ink);
  }
  a {
    color: var(--c-link);
  }
  a:visited {
    color: var(--c-link-visited);
  }
  :focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
</style>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--c-border);
  }
  .site-name {
    color: var(--c-ink);
    font-weight: 600;
    text-decoration: none;
  }
</style>
