---
// fixture: explicit null checks, a boolean guard, and a guard whose value is only passed on as an attribute.
// A `v || ''` in a comment is not read.
import Absent from './Absent.astro';
const { claim, open, reason } = Astro.props;
const label = claim.label ?? claim.id;
---
<td>{claim.value != null ? <span class="n">{claim.value}</span> : <Absent kind="not-reported" />}</td>
<td>{open && <details open>more</details>}</td>
<td>{reason && <span data-reason={reason}>unverified</span>}</td>
<td>{label}</td>
