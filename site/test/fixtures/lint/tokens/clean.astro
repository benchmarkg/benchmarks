---
// fixture: a URL fragment and a token read from tokens.json are not colour literals
import tokens from '../../../../src/lib/tokens.json';
const href = '#methodology';
const ink = tokens.themes.light['c-ink'].hex;
---
<a href={href} style="color: var(--c-link); font-size: var(--fs-sm)">{ink}</a>
<style>
  a { text-decoration-thickness: 1px; }
</style>
