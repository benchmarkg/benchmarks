---
// site/test/fixtures/provenance.astro -- P2-S3-T02. The page tests/provenance.spec.ts drives: one ProvenanceDetails
// per row of provenance-claims.json (make_provenance_fixture.py writes it from the committed claims and the build's
// comparability arithmetic), in the detail page's zero-JavaScript shell. Routed at /_fixtures/provenance only when
// UAIBI_SITE_FIXTURES names it (astro.config.mjs), never in a normal build.
import Base from '../../src/layouts/Base.astro';
import ProvenanceDetails from '../../src/components/ProvenanceDetails.astro';
import type { ClaimRow } from '../../src/lib/claims';
import fixture from './provenance-claims.json';

const rows = fixture.rows as unknown as ClaimRow[];
---
<Base title="Provenance fixture" zeroJs>
  <main>
    <h1>Provenance fixture</h1>
    <ul class="rows">
      {rows.map((row) => <li data-row={row.claim.id}><code>{row.claim.system}</code> on <code>{row.claim.benchmark}</code>: <ProvenanceDetails row={row} /></li>)}
    </ul>
  </main>
</Base>

<style>
  main {
    max-inline-size: 68rem;
    margin-inline: auto;
    padding: var(--sp-4);
  }
  .rows {
    display: grid;
    gap: var(--sp-3);
  }
</style>
