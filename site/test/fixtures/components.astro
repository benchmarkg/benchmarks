---
// site/test/fixtures/components.astro -- P2-S2-T06. Every component of 09 S6 on one page, for site/tests/components.spec.ts
// (what only a browser shows: ChartFigure's hydration, ValueCell's popover) and for looking at. Routed at
// /_fixtures/components only when UAIBI_SITE_FIXTURES names it (astro.config.mjs). The data is made up.
import Base from '../../src/layouts/Base.astro';
import Absent from '../../src/components/Absent.astro';
import BenchmarkCard from '../../src/components/BenchmarkCard.astro';
import ChartFigure from '../../src/components/ChartFigure.astro';
import CiteThis from '../../src/components/CiteThis.astro';
import ComparabilityBanner from '../../src/components/ComparabilityBanner.astro';
import ConditionMeter from '../../src/components/ConditionMeter.astro';
import Contribute from '../../src/components/Contribute.astro';
import EmptyState from '../../src/components/EmptyState.astro';
import FacetChips from '../../src/components/FacetChips.astro';
import Skeleton from '../../src/components/Skeleton.astro';
import SourceCitation from '../../src/components/SourceCitation.astro';
import Staleness from '../../src/components/Staleness.astro';
import ValueCell from '../../src/components/ValueCell.astro';
import VerificationBadge from '../../src/components/VerificationBadge.astro';

const SHA = '0123456789abcdef0123456789abcdef01234567';
const TODAY = new Date('2026-10-06T00:00:00Z');
const source = { source_id: 'src-example', title: 'An example technical report', publisher: 'Example Lab',
  url: 'https://example.org/report', archive_url: 'https://web.archive.org/web/2026/https://example.org/report',
  retrieved_at: '2026-10-01', source_type: 'technical-report' };
---
<Base title="Component inventory fixture">
  <main class="inventory">
    <h1>Component inventory (fixture)</h1>

    <section><h2>BenchmarkCard</h2>
      <div class="cards">
        <BenchmarkCard id="example-a" name="Example A" tagline="A made-up benchmark whose ceiling is known." primary_domain="biology-genetics/protein-design"
          capabilities={['knowledge-recall']} lifecycle="proposed" year_released={2025} ceiling_anchor_type="theoretical-maximum"
          headroom_consumed={0.42} claim_count={12} last_verified_at="2026-09-01" today={TODAY} />
        <BenchmarkCard id="example-b" name="Example B" tagline="A made-up benchmark with no known ceiling." primary_domain="biology-genetics"
          capabilities={[]} lifecycle="proposed" year_released={2024} ceiling_anchor_type="none-known"
          headroom_consumed={null} claim_count={0} last_verified_at={null} today={TODAY} />
      </div>
    </section>

    <section><h2>FacetChip</h2>
      <FacetChips chips={[{ facet: 'domain', term_id: 'biology-genetics' }, { facet: 'capability', term_id: 'knowledge-recall', state: 'filter-active', href: '?' }, { facet: 'lifecycle', term_id: 'proposed', state: 'filter-available', href: '?l', count: 3 }]} />
    </section>

    <section><h2>VerificationBadge, ConditionMeter, Absent, Staleness</h2>
      <p><VerificationBadge verification="independent-reproduction" /> <VerificationBadge verification="self-reported" disputed disputed_by={['dsp-example']} /></p>
      <p><ConditionMeter condition_completeness={1 / 11} fields_specified={1} fields_material_total={11} /> <Absent state="not-reported" /></p>
      <p><Staleness last_verified_at="2025-01-15" entity_kind="benchmark" today={TODAY} /></p>
    </section>

    <section><h2>ValueCell</h2>
      <table><tbody><tr><th scope="row">Example model</th><td>
        <ValueCell value={0.712} metric_id="accuracy" unit="fraction" verification="maintainer-verified" condition_completeness={2 / 4}
          fields_specified={2} fields_material_total={4} claim_id="clm-example" comparability_key="k1" uncertainty={0.012} source={source}
          reporter="Example Lab" date_reported="2026-05-04" conditions={{ shots: 0, temperature: null, selection_strategy: null, n_samples: 1 }}
          commit_sha={SHA} yaml_path="data/claims/clm-example.yaml" />
      </td></tr></tbody></table>
    </section>

    <section><h2>SourceCitation</h2>
      <p><SourceCitation {...source} /></p>
      <p><SourceCitation {...source} archive_url={null} /></p>
    </section>

    <section><h2>ComparabilityBanner</h2>
      <ComparabilityBanner keys={['k1', 'k2']} set_labels={['Set A', 'Set B']} restrict_href="?r" restrict_drops={3} proceed_href="?p"
        diff={[{ field: 'n_samples', values: [1, 5] }, { field: 'selection_strategy', values: ['best-of-n', null] }]} />
    </section>

    <section><h2>EmptyState</h2>
      <EmptyState context="coverage-cell" domain="biology-genetics" capability="knowledge-recall" />
    </section>

    <section><h2>Skeleton</h2>
      <Skeleton for="ai-panel" inline_size="20rem" block_size="3rem" />
    </section>

    <section><h2>ChartFigure</h2>
      <ChartFigure data={{ caption: 'Rows by verification rule (fixture)', units: 'rows',
        columns: [{ key: 'rule', label: 'Rule' }, { key: 'n', label: 'Rows' }],
        rows: [{ rule: 'public log', n: 828 }, { rule: 'private log', n: 459 }, { rule: 'no log', n: 263 }] }}
        chart={{ type: 'bar', x: 'rule', y: 'n' }} />
    </section>

    <section><h2>CiteThis, Contribute</h2>
      <CiteThis entity_id="example-a" title="Example A" commit_sha={SHA} release_doi={null} retrieved_at="2026-10-06" yaml_path="data/benchmarks/example-a.yaml" />
      <Contribute entity_id="example-a" entity_kind="benchmark" yaml_path="data/benchmarks/example-a.yaml" />
    </section>
  </main>
</Base>

<style>
  .inventory {
    padding: var(--sp-4);
    display: grid;
    gap: var(--sp-6);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--sp-4);
  }
</style>
