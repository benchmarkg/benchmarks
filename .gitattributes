# Line endings. Required by _plan/08-infrastructure-and-build.md §12 ("Determinism"):
# without this, core.autocrlf on Windows changes every file's sha256 between machines
# and `bench verify --commit <sha>` fails for a reason unrelated to the build. The
# maintainer's environment is Windows, so this is a live condition, not a hypothetical.

* text=auto eol=lf

*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.toml text eol=lf

# Binary: never normalise. .npz is the Atlas projection basis (10 §"drift gate"),
# .woff2 the subset IBM Plex faces (09 §"type"), .zip the Epoch bundle fixture, whose sha256 its
# test checks (P3-S1-T03).
*.npz   binary
*.woff2 binary
*.woff  binary
*.png   binary
*.zip   binary
*.jpg   binary
*.webp  binary
*.pdf   binary

# Captured upstream responses are byte-exact ("strip nothing", P5-S1-T02): never normalise them.
# Each body's sha256 is recorded in its <name>.headers.json and checked by the fixture tests.
tests/ingest/fixtures/** -text

# The normaliser fixture's mixed line endings are the point of it (P0-S4-T04): never normalise.
tests/schema/fixtures/*.html -text

# 07 S6.4 exception (a): the run logs and state files commit to main under ingest/**, outside the
# citable data tree, and never enter a release tarball (P5-S4-T01).
ingest/runs/** export-ignore
ingest/state/** export-ignore
